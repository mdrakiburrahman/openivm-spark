# GitHub repo URL the runner registers against.
GH_REPO=https://github.com/mdrakiburrahman/openivm-spark

# Azure subscription + resource group for the runner stack. The RG must NOT
# pre-exist — the module creates it.
TF_RESOURCE_GROUP=
TF_SUBSCRIPTION_ID=

# Runner configuration (pass-through to the KangarooKube github-runner module).
TF_VAR_location=
TF_VAR_instance_sku=
TF_VAR_instance_count=

# Terraform state.
TF_STATE_STORAGE_ACCOUNT_NAME=
TF_STATE_STORAGE_ACCOUNT_CONTAINER=
TF_STATE_STORAGE_ACCOUNT_KEY=

# Private feed
MAVEN_PAT=
MAVEN_URL=

# GHCR publication. Local publishing requires a classic PAT with write:packages
# plus its username. GitHub Actions uses GITHUB_TOKEN plus GITHUB_ACTOR instead
# and must grant packages: write.
GHCR_USERNAME=
GHCR_TOKEN=
