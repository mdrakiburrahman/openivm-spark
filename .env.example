# GitHub repo URL the runner registers against. The runner registration token
# is auto-minted by contrib/deploy-gh-runner.sh via `gh api`, so an
# authenticated `gh auth login` is the only GitHub credential you need.
GH_REPO=https://github.com/mdrakiburrahman/openivm-spark

# Azure subscription + resource group for the runner stack. The RG must NOT
# pre-exist — the module creates it.
TF_RESOURCE_GROUP=gh-openivm-spark-rg
TF_SUBSCRIPTION_ID=ce859648-30e1-4135-9d0f-8358aebfe789

# Runner configuration (pass-through to the KangarooKube github-runner module).
TF_VAR_location=australiacentral
TF_VAR_instance_sku=Standard_E48as_v5
TF_VAR_instance_count=2

# Terraform state. Reuses the rakirahman storage account / tfstate container;
# the state-file key is hard-coded inside contrib/deploy-gh-runner.sh to
# github-runner-openivm-spark.tfstate so it never collides with ivm-bench.
TF_STATE_STORAGE_ACCOUNT_NAME=rakirahman
TF_STATE_STORAGE_ACCOUNT_CONTAINER=tfstate
TF_STATE_STORAGE_ACCOUNT_KEY=
