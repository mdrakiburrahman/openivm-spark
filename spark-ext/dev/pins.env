# Pinned dependencies for the openivm-spark dev container.
# Bump SHAs after the corresponding work lands on ila/openivm:main and ila/lpts:main.

# openivm upstream (built into the openivm-builder stage, produces openivm.duckdb_extension)
OPENIVM_REPO=https://github.com/mdrakiburrahman/openivm.git
OPENIVM_BRANCH=dev/mdrrahman/add-months-ila
OPENIVM_COMMIT=2845bc4379172e0ad0377f3fb9126fa2837c7d7b

# lpts upstream (built as a submodule of openivm; overridden inside the Dockerfile)
# Pinned to fork branch dev/mdrrahman/spark-add-months (cwida/lpts#18, DRAFT) until it
# merges into cwida/lpts:main; repoint back to cwida + the merged SHA post-merge.
#
# Delta time travel needs NO LPTS change: openivm-spark splits the snapshot pin
# out of the compile copy before LPTS sees it
# (docs/architecture/openivm-spark/4-duckdb-cli-compile-bridge.md §7).
#
# dbac36de adds Spark `temporalClause` support to the LPTS front end (aliased
# pinned relations and a source read at two versions included). 66bf3ae — the
# first cut of that work — must be skipped: it re-emits the clause AFTER the
# alias (`… p VERSION AS OF 2`), which parses in neither dialect.
# openivm-spark does not depend on LPTS accepting the clause (it never lets one
# reach DuckDB), so this pin is a compatibility floor, not a feature gate; the
# bridge refuses un-maintainable pin shapes itself rather than relying on the
# downstream parser rejecting them.
LPTS_REPO=https://github.com/mdrakiburrahman/lpts.git
LPTS_BRANCH=dev/mdrrahman/spark-add-months
LPTS_COMMIT=dbac36de2e7e00d22fcb48250662fd69c0c106cd

# IVM bench working repo
IVM_BENCH_REPO=https://github.com/mdrakiburrahman/ivm-bench.git
IVM_BENCH_BRANCH=main
IVM_BENCH_COMMIT=9e4aa203fbde5d06abb2f2521a38b328fb7de637

# Apache Spark upstream — read-only reference checkout (shallow --depth 1 clone
# into .temp/spark at the v$SPARK_VERSION release tag; see Toolchain below).
SPARK_REPO=https://github.com/apache/spark.git
SPARK_REF=v3.5.1
SPARK_COMMIT=fd86f85e181fc2dc0f50a096855acf83a6cc5d9c

# Delta Lake upstream — read-only reference checkout (shallow --depth 1 clone
# into .temp/delta at the v$DELTA_VERSION release tag; see Toolchain below).
# NOTE: v3.2.0 is an annotated tag — DELTA_COMMIT is the *peeled* commit it
# points to (refs/tags/v3.2.0^{}), i.e. what `git checkout v3.2.0` lands on.
DELTA_REPO=https://github.com/delta-io/delta.git
DELTA_REF=v3.2.0
DELTA_COMMIT=4e7a342348f5d746d6407f79f43e8281281c7b49

# Toolchain
JDK_VERSION=17
SBT_VERSION=1.9.7
SCALA_VERSION=2.12.17
SPARK_VERSION=3.5.1
DELTA_VERSION=3.2.0
ANTLR_VERSION=4.9.3

# DuckDB JDBC (must match openivm's bundled DuckDB ABI; openivm CI pins v1.5.2)
DUCKDB_JDBC_VERSION=1.5.2.1

# Ubuntu mirror override for slow networks (passes through to apt sources)
UBUNTU_MIRROR=http://archive.ubuntu.com/ubuntu
