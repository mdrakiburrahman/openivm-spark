# Pinned dependencies for the openivm-spark dev container.
# Immutable native and LPTS revisions consumed by the dev and CI builds.

# openivm upstream (built into the openivm-builder stage, produces openivm.duckdb_extension)
OPENIVM_REPO=https://github.com/ila/openivm.git
OPENIVM_BRANCH=main
OPENIVM_COMMIT=8c5940a952b19ab13f2d235df9d9e5463576f8be

# lpts upstream (built as a submodule of openivm; overridden inside the Dockerfile)
# Consume the merged cwida/lpts#19 revision required by the OpenIVM pin.
LPTS_REPO=https://github.com/cwida/lpts.git
LPTS_BRANCH=main
LPTS_COMMIT=29c606ee18ad8e4d04cab940f361cbf6fbe5b881

# IVM bench working repo
IVM_BENCH_REPO=https://github.com/mdrakiburrahman/ivm-bench.git
IVM_BENCH_BRANCH=main
IVM_BENCH_COMMIT=9e4aa203fbde5d06abb2f2521a38b328fb7de637

# Shared toolchain
SBT_VERSION=1.9.7
ANTLR_VERSION=4.9.3

# Build the CLI and extension against the deployed ABI, independently of
# OpenIVM's upstream DuckDB submodule/CI (currently v1.5.4).
DUCKDB_REF=v1.5.2
DUCKDB_COMMIT=8a5851971fae891f292c2714d86046ee018e9737
NATIVE_BUILD_JOBS=8

# JDBC stays on the matching 1.5.2 release line; compilation uses the CLI.
DUCKDB_JDBC_VERSION=1.5.2.1

# Ubuntu mirror override for slow networks (passes through to apt sources)
UBUNTU_MIRROR=http://archive.ubuntu.com/ubuntu
