# Pinned dependencies for the openivm-spark dev container.
# Bump SHAs after pushing patches to mdrakiburrahman/openivm and mdrakiburrahman/lpts.

# openivm fork (built into the openivm-builder stage, produces openivm.duckdb_extension)
OPENIVM_REPO=https://github.com/mdrakiburrahman/openivm.git
OPENIVM_BRANCH=openivm-spark
OPENIVM_COMMIT=2b712a0a34afa0a97c9730aacef74eafd9a8096a

# lpts fork (built as a submodule of openivm; overridden inside the Dockerfile)
LPTS_REPO=https://github.com/mdrakiburrahman/lpts.git
LPTS_BRANCH=openivm-spark-glibc-2.35
LPTS_COMMIT=2b2ff6307eb439dde6074b6de002d3ac2512a363

# IVM bench working repo
IVM_BENCH_REPO=https://github.com/mdrakiburrahman/ivm-bench.git
IVM_BENCH_BRANCH=dev/mdrrahman/spark-openivm
IVM_BENCH_COMMIT=a84cf1709d1b3d67f5a099ad5f315a9db11536e6

# Toolchain
JDK_VERSION=17
SBT_VERSION=1.9.7
SCALA_VERSION=2.12.17
SPARK_VERSION=3.5.1
DELTA_VERSION=3.2.0
ANTLR_VERSION=4.9.3

# DuckDB JDBC (must match openivm's bundled DuckDB ABI; openivm CI pins v1.5.2)
DUCKDB_JDBC_VERSION=1.5.2.1

# Ubuntu mirror override for slow networks (passes through to apt sources)
UBUNTU_MIRROR=http://archive.ubuntu.com/ubuntu
