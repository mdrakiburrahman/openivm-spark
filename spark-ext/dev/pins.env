# Pinned dependencies for the openivm-spark dev container.
# Bump SHAs after the corresponding work lands on ila/openivm:main and ila/lpts:main.

# openivm upstream (built into the openivm-builder stage, produces openivm.duckdb_extension)
OPENIVM_REPO=https://github.com/ila/openivm.git
OPENIVM_BRANCH=main
OPENIVM_COMMIT=fbf2ebbe97faad258e53f4ccec93beac8f30fe96

# lpts upstream (built as a submodule of openivm; overridden inside the Dockerfile)
LPTS_REPO=https://github.com/ila/lpts.git
LPTS_BRANCH=main
LPTS_COMMIT=17aa1ea0b0c58bb12e2a75bd275094fc8d4649ad

# IVM bench working repo
IVM_BENCH_REPO=https://github.com/mdrakiburrahman/ivm-bench.git
IVM_BENCH_BRANCH=dev/mdrrahman/spark-openivm
IVM_BENCH_COMMIT=59b0998ea04f1b92e13708d6f0ecca580dda610f

# Toolchain
JDK_VERSION=17
SBT_VERSION=1.9.7
SCALA_VERSION=2.12.17
SPARK_VERSION=3.5.1
DELTA_VERSION=3.2.0
ANTLR_VERSION=4.9.3

# DuckDB JDBC (must match openivm's bundled DuckDB ABI; openivm CI pins v1.5.2)
DUCKDB_JDBC_VERSION=1.5.2.1

# Ubuntu mirror override for slow networks (passes through to apt sources)
UBUNTU_MIRROR=http://archive.ubuntu.com/ubuntu
