{
  "name": "openivm-spark",
  "image": "ghcr.io/mdrakiburrahman/openivm-spark-devcontainer:3c4c01cd16490635f27e0bc43b0b7968a9602974ebb15379dbcfac8f236ae845",
  "containerUser": "vscode",
  "containerEnv": {
    "NX_DAEMON": "false",
    "OPENIVM_CLI_PATH": "/opt/openivm/duckdb",
    "OPENIVM_EXTENSION_PATH": "/opt/openivm/openivm.duckdb_extension",
    "OPENIVM_JAVA_HOME_SPARK_35": "/opt/java/jdk-17",
    "OPENIVM_JAVA_HOME_SPARK_41": "/opt/java/jdk-21",
    "OPENIVM_NATIVE_DIR": "/opt/openivm",
    "OPENIVM_SPARK_TARGET": "spark-3.5",
    "SBT_OPTS": "-Xmx4G -XX:+UseG1GC -Dsbt.color=always -Dfile.encoding=UTF-8"
  },
  "mounts": ["source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"],
  "overrideCommand": false,
  "postCreateCommand": "bash .devcontainer/scripts/post-create.sh",
  "remoteEnv": {
    "HOME": "/home/vscode"
  },
  "remoteUser": "vscode",
  "runArgs": [
    "--add-host=host.docker.internal:host-gateway",
    "--cap-add=SYS_ADMIN",
    "--device=/dev/fuse",
    "--init",
    "--platform=linux/amd64",
    "--pids-limit=-1",
    "--security-opt=apparmor:unconfined"
  ],
  "updateRemoteUserUID": true,
  "workspaceFolder": "/workspaces/openivm-spark",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/openivm-spark,type=bind,consistency=cached"
}
